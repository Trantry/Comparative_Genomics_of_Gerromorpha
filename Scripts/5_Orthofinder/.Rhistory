## ---- Barplot split par ONTOLOGY (top N par BP/CC/MF) ----
library(enrichplot)
library(ggplot2)
library(dplyr)
library(GO.db)
library(AnnotationDbi)
# 1) Ajouter ONTOLOGY à TON objet enricher (ex: ego_N2_named)
onto_map <- AnnotationDbi::select(
GO.db,
keys = unique(ego_N2_named@result$ID),
keytype = "GOID",
columns = c("GOID", "ONTOLOGY")
) %>%
distinct(GOID, ONTOLOGY) %>%
transmute(ID = GOID, ONTOLOGY = ONTOLOGY)
onto_map
ego_N2_onto <- ego_N2_named
ego_N2_onto@result <- ego_N2_onto@result %>% left_join(onto_map, by = "ID")
# 2) Barplot : top 15 PAR ontologie
p_n2_bar_nofacet <- barplot(
ego_N2_onto,
x = "Count",
showCategory = 15,
split = "ONTOLOGY",
label_format = 30        # wrap des labels (mets Inf si tu ne veux pas wrap)
) +
aes(fill = ONTOLOGY) +
scale_fill_brewer(palette = "Set2")
p_n2_bar_nofacet +
geom_text(aes(label = Count), nudge_x = 2, size = 3) +
scale_y_discrete()
# Option facet (BP/CC/MF séparés)
p_n2_bar_facet <- p_n2_bar_nofacet +
enrichplot::autofacet(by = "row", scales = "free") +
scale_y_discrete()
p_n2_bar_facet
