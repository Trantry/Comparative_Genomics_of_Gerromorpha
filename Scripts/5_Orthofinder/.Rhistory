# Filtrer N11 Support >= 0.5
dup_N11  <- subset(dup, Species.Tree.Node == "N11"  & Support >= 0.5)
# Fonction utilitaire: transforme "g1, g2, g3" en vecteur de gènes
split_genes <- function(x) {
x <- x[!is.na(x) & x != ""]
g <- unlist(strsplit(x, ",\\s*"))
g <- trimws(g)
g[g != ""]
}
# Extraire union(Genes 1, Genes 2) et dédupliquer
genes_N11  <- sort(unique(c(split_genes(dup_N11$Genes.1),  split_genes(dup_N11$Genes.2))))
# Sauver en fichiers
writeLines(genes_N11,  "genes_N11_support0.5.txt")
# Contrôle
length(genes_N11)
c(
events = nrow(dup_N11),
orthogroups = length(unique(dup_N11$Orthogroup)),
unique_genes = length(genes_N11)
)
