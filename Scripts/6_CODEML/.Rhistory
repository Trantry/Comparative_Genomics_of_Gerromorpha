"OG0004649"
)
fasta_files <- list.files(fasta_dir, pattern = "\\.fa$|\\.fasta$", full.names = TRUE)
read_og_fasta_headers <- function(f) {
og <- tools::file_path_sans_ext(basename(f))
headers <- readLines(f)
headers <- headers[grepl("^>", headers)]
headers <- sub("^>", "", headers)
tibble(
OG = og,
header = headers
) %>%
separate(
header,
into = c("species", "transcript"),
sep = "\\|",
remove = FALSE
) %>%
mutate(
gene_id = paste0(species, "|", transcript)
)
}
OG2genes <- bind_rows(lapply(fasta_files, read_og_fasta_headers)) %>%
distinct()
head(OG2genes)
View(OG2genes)
length(unique(OG2genes$OG))
length(unique(OG2genes$gene_id))
get_attr <- function(attr, key) {
# récupère key=value dans la colonne attributs GFF
pattern <- paste0("(^|;)", key, "=([^;]+)")
out <- str_match(attr, pattern)[, 3]
out
}
read_gff_GO <- function(gff_path) {
species <- basename(dirname(gff_path))
gff <- read.delim(
gff_path,
sep = "\t",
header = FALSE,
comment.char = "#",
quote = "",
stringsAsFactors = FALSE,
col.names = c(
"seqid", "source", "type", "start", "end",
"score", "strand", "phase", "attributes"
)
)
gff %>%
filter(type == "mRNA") %>%
mutate(
transcript = get_attr(attributes, "ID"),
go_raw     = get_attr(attributes, "Ontology_term"),
product    = get_attr(attributes, "product"),
gene_id    = paste0(species, "|", transcript)
) %>%
filter(!is.na(go_raw), go_raw != "", go_raw != "-") %>%
separate_rows(go_raw, sep = ",") %>%
mutate(
term = str_extract(go_raw, "GO:[0-9]+")
) %>%
filter(!is.na(term)) %>%
transmute(
species = species,
transcript = transcript,
gene_id = gene_id,
term = term,
product = product
) %>%
distinct()
}
gff_files <- list.files(
agat_dir,
pattern = "\\.gff$|\\.gff3$",
full.names = TRUE,
recursive = TRUE
)
TERM2GENE_transcripts <- bind_rows(lapply(gff_files, read_gff_GO)) %>%
distinct()
View(TERM2GENE_transcripts)
head(TERM2GENE_transcripts)
OG_GO <- OG2genes %>%
inner_join(TERM2GENE_transcripts, by = "gene_id") %>%
select(OG, species = species.x, transcript, term, product) %>%
distinct()
OG_GO <- OG2genes %>%
dplyr::inner_join(TERM2GENE_transcripts, by = "gene_id") %>%
dplyr::select(
OG,
species = species.x,
transcript,
term,
product
) %>%
dplyr::distinct()
tmp_join <- OG2genes %>%
dplyr::inner_join(TERM2GENE_transcripts, by = "gene_id")
names(tmp_join)
View(tmp_join)
View(OG2genes)
View(TERM2GENE_transcripts)
