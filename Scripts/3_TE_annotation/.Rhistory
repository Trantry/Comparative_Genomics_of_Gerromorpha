plot_title_gerro <- "Paysages d'éléments répétés des Gerromorpha "
plot_title_gerro <- "Repeat landscapes Gerromorpha (percent of genome)"
p_gerro <- ggplot(df_all_gerro, aes(x = kimura80, y = KIMURA_PERCENT, fill = named_subclass)) +
geom_col(position = "stack", width = 0.01) +
scale_fill_manual(values = fill_colours_gerro$fill_colour, name = "Sous-classe d'ET") +
facet_wrap(~species, ncol = 3, scales = "fixed") +
theme_bw() +
labs(title = plot_title_gerro) +
theme(plot.title = element_text(hjust = 0.5),
strip.text = element_text(size = 10)) +
scale_y_continuous(limits = c(0, y_limit_gerro), expand = c(0,0), name = "Pourcentage du génome (%)") +
{ if(axis_flip_gerro) scale_x_continuous(limits = c(0.51, -0.01), expand = c(0,0), name = "Distance de Kimura à 2 paramètres (K2P)", trans = "reverse")
else scale_x_continuous(limits = c(-0.01, 0.51), expand = c(0,0), name = "Distance de Kimura à 2 paramètres (K2P)")
}
p_gerro
